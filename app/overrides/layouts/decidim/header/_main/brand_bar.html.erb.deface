<!-- insert_before "#main-bar" -->
<div class="brand-bar home__section">
  <div class="bcn-cat-link">
    <%= link_to "https://www.barcelona.cat", target: "_blank", data: { external_link: "text-only" } do %>
      <%= image_pack_tag "media/images/logo-ajbcn.svg", class: "bcnbrand-main-link", alt: t(".organization_logo") %>
    <% end %>
  </div>
  <div class="brand-bar__values">
    <%= image_pack_tag "media/images/values.png", class: "bcnbrand-values", alt: t(".values") %>
  </div>
</div>
